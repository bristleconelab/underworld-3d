{
  "name": "underworld-3d",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "3D workbench for subducted slabs (Atlas of the Underworld), Slab2, deep seismicity, PB2002 and PREM, with great-circle cross-sections and data export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:quakes": "node scripts/build_quakes.mjs",
    "data:atlas": "uv run --with openpyxl python scripts/build_atlas.py",
    "data:slab2": "uv run --with h5py --with numpy python scripts/build_slab2.py",
    "shots": "node scripts/screenshots.mjs",
    "seo": "node scripts/seo_pages.mjs",
    "data:boundaries": "python3 scripts/build_boundaries.py",
    "test:py": "cd scripts && python3 -m unittest discover -s . -p \"test_*.py\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.187.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
