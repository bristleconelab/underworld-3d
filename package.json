{
  "name": "underworld-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open the Earth: sunken ocean floors in the mantle, subducting plates and deep earthquakes on a 3D globe.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:quakes": "node scripts/build_quakes.mjs",
    "data:atlas": "uv run --with openpyxl python scripts/build_atlas.py",
    "data:slab2": "uv run --with h5py --with numpy python scripts/build_slab2.py",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.187.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
